# BIS SmartAI Backend — Environment Variables Template
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.

# ============================================================
# DATABASE — Neon PostgreSQL
# ============================================================
DATABASE_URL=

# ============================================================
# GROQ AI (Primary High-Speed Provider)
# ============================================================
GROQ_API_KEY=

# ============================================================
# GEMINI AI & EMBEDDINGS (Required for RAG Embeddings)
# ============================================================
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
EMBEDDING_MODEL=models/gemini-embedding-001
RAG_ENABLED=true
RAG_TOP_K=5

# ============================================================
# JWT Authentication
# ============================================================
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============================================================
# CORS — React Frontend Origin
# ============================================================
FRONTEND_URL=http://localhost:5173

# ============================================================
# Application
# ============================================================
APP_NAME=BIS SmartAI
APP_ENV=development
DEBUG=true
